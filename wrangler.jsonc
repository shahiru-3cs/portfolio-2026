// Cloudflare Workers (static assets) config.
// Deploy with: npm run deploy   (runs `next build` then `wrangler deploy`)
// Or use Cloudflare Pages instead: build command `npm run build`, output directory `out`.
{
  "name": "shahiru-portfolio",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
